# AI Proxy Worker - Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git!

# NVIDIA API Keys (get from https://integrate.api.nvidia.com)
# Add as many as you want: NV_1, NV_2, NV_3, ...
NV_1=your-nvidia-api-key-1
NV_2=your-nvidia-api-key-2

# OpenRouter API Keys (get from https://openrouter.ai/keys)
# Only FREE models are supported
# Add as many as you want: OR_1, OR_2, OR_3, ...
OR_1=your-openrouter-api-key-1
OR_2=your-openrouter-api-key-2

# Optional: Protect your endpoint with a custom token
# If set, all requests must include: Authorization: Bearer YOUR_PROXY_TOKEN
PROXY_TOKEN=your-secure-random-token

# Optional: Custom referer/title for OpenRouter (shown in their dashboard)
OPENROUTER_REFERER=https://your-domain.alwaysdata.net
OPENROUTER_TITLE=My AI Proxy

# Server port (alwaysdata sets PORT env var automatically)
# PORT=3000